# ==============================================================================
# SEO Automation Dashboard — Environment Variables Reference
# ==============================================================================

# Mock Mode Switch (Section 2.2)
# Set to 'true' for zero-cost testing, or 'false' in production with live APIs
USE_MOCKS=true

# Anthropic Claude API (claude-3-5-sonnet / claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase / PostgreSQL Database Connection (Section 5 - Prisma)
# Session/Transaction pooler URI for serverless:
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URI for Prisma migrations:
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# Upstash Redis for BullMQ Queue (Section 3.1)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Twilio WhatsApp Dispatch (Optional - Section 2.3 console.log mock is used when empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Deployment Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
